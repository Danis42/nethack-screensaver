#!/usr/bin/env python3
"""Refuses a commit without a valid Kind label (CODE-02, D-14); the rule is in commit_kind.py."""
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
sys.path.insert(1, str(HERE.parent))  # bench.metrics for metric names, when importable
from commit_kind import check  # noqa: E402

git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True).stdout.strip()
if git_dir and os.path.exists(os.path.join(git_dir, "MERGE_HEAD")):
    sys.exit(0)
message = "\n".join(line for line in Path(sys.argv[1]).read_text().splitlines() if not line.startswith("#"))
paths = subprocess.run(["git", "diff", "--cached", "--name-only"], capture_output=True, text=True).stdout.split()
errors = check(message, paths)
if errors:
    print("commit refused (see githooks/commit_kind.py):", *("  " + e for e in errors), sep="\n", file=sys.stderr)
    sys.exit(1)
